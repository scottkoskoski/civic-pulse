# Copy to .env (in the repo root) and fill in real values.
# .env is gitignored so secrets never leak into version control.

# The 4-by-4 Socrata dataset id for the Memphis crime/incidents dataset.
# Find it at https://data.memphistn.gov by searching for "incidents"
# or "crime"; the id (formatted like "abcd-1234") appears in the
# dataset URL. See docs/lesson-02-ingest-and-sources.md for the
# step-by-step lookup.
SOCRATA_DATASET_ID=

# Optional Socrata application token. Without one you'll get
# anonymous rate limits (usually fine for occasional manual pulls).
# Get one free at https://dev.socrata.com if you start hitting 429s.
SOCRATA_APP_TOKEN=

# Optional. If unset, the loader writes to civic_pulse.duckdb at the
# repo root, matching the path you configured in ~/.dbt/profiles.yml.
# Override only if you keep the DuckDB file elsewhere.
DUCKDB_PATH=
